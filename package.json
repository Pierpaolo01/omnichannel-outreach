{
  "name": "omnichannel-outreach",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.1.0",
  "engines": {
    "node": ">=22.18 <23"
  },
  "scripts": {
    "dev": "node --watch-path=src/server --watch-path=src/domain --no-warnings=ExperimentalWarning src/server/main.ts",
    "start": "NODE_ENV=production node --no-warnings=ExperimentalWarning src/server/main.ts",
    "build": "vite build",
    "seed:dev": "node --no-warnings=ExperimentalWarning scripts/seed-dev.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/schibsted-grotesk": "5.3.0",
    "@hono/node-server": "1.19.19",
    "csv-parse": "6.2.1",
    "hono": "4.13.18",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "wouter": "3.13.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "daisyui": "5.8.0",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "^17.14.0",
    "tailwindcss": "4.3.5",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  }
}
